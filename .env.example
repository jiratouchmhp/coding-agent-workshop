# =============================================================================
# Enterprise Coding Agent Workshop — Environment Configuration Template
# =============================================================================
# Copy to `.env` at the repository root and fill in your GCP project values:
#   cp .env.example .env
# Never commit `.env` to version control.
#
# IMPORTANT — Standard Billing GCP Project Required for Labs 2-8:
# Do NOT set GOOGLE_GENAI_API_KEY or GEMINI_API_KEY (Express Mode / AI Studio)
# when running Labs 2-8; Express Mode enforces strict free-tier caps (10 agents,
# 10 QPM, 30 session appends/min) and disables BYOC Sandboxes, Terraform IAM,
# Registries, Online Monitors, and Cloud Monitoring Alerts.
# =============================================================================

# --- Core GCP Project & Regional Architecture (Labs 0-8) ---------------------
# Bangkok (`asia-southeast3`) First — Fall Back to Singapore (`asia-southeast1`) Only for
# Services Not Yet Available in Bangkok:
#   - Bangkok (`asia-southeast3`, default target): Artifact Registry, Cloud Build (zero local
#     Docker), Secret Manager, Agent Registry A2A/MCP discovery, and Lab 8 Self-Hosted GKE
#     (Thailand PDPA / BoT residency).
#   - Singapore (`asia-southeast1`, nearest fallback): Used only for Agent Platform services not
#     yet available in Bangkok — Agent Runtime (`ReasoningEngine`), Managed Sandboxes
#     (Shell/BYOC/Code Exec), Managed Sessions, Memory Bank, Agent Gateway (and strict
#     regional Gemini 4 inference when opting into `MODEL_NAME=gemini-4-argon`).
#   - Service-mandated overrides: `MODEL_LOCATION=global` (frontier Gemini 4 models
#     `gemini-4-hydrogen` and `gemini-4-neon`), `SKILL_REGISTRY_LOCATION=us-central1`
#     (3-region Preview), `AGENT_REGISTRY_SKILLS_LOCATION=global` (Agent Registry standalone
#     skills), and `EVAL_LOCATION=global` (14 US/EU regions + `global`, APAC-ready & supports
#     loss clustering).
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
PRIMARY_REGION=asia-southeast3
GOOGLE_CLOUD_LOCATION=asia-southeast1
# Bangkok Artifact Registry (`asia-southeast3`) is verified working for both Singapore Agent
# Runtime and Singapore BYOC Sandboxes — keep a single repository in Bangkok.
AR_LOCATION=asia-southeast3
BUILD_LOCATION=asia-southeast3

# --- Frontier Gemini 4 Model & Thinking Configuration ------------------------
# Frontier Gemini 4 models (`gemini-4-hydrogen` for fast coding & tool calling,
# `gemini-4-neon` for deep architecture, planning & review) require `MODEL_LOCATION=global`
# (HTTP 404 on `asia-southeast1`, HTTP 501 on `asia-southeast3`).
# Strict regional residency alternative: set `MODEL_NAME=gemini-4-argon`,
# `REASONING_MODEL_NAME=gemini-4-argon`, and `MODEL_LOCATION=asia-southeast1`.
# Requires `google-genai>=2.34.0` for automatic `continuation_token` long decodes.
MODEL_NAME=gemini-4-hydrogen
REASONING_MODEL_NAME=gemini-4-neon
MODEL_LOCATION=global
# Gemini 4 thinking level — valid values strictly: LOW | MEDIUM | HIGH | XHIGH
# (NEVER pass `MINIMAL` or `thinking_budget`, which return HTTP 400 on Gemini 4;
# custom temperature/top_p/top_k are ignored by Gemini 4).
THINKING_LEVEL=MEDIUM

# --- Lab 1: ADK 2.0 Agent Architecture & Workflow Orchestration --------------
# Valid values: simple | collaborative | graph | dynamic | agy_harness
# Keep `simple` as the default so Labs 2-8 run unchanged on ADK Python 2.0+.
AGENT_ARCHITECTURE=simple
# Explicit safety bound on fix iterations in `graph`, `dynamic`, and `agy_harness` workflows:
MAX_FIX_ROUNDS=3
# Set to `true` to pause `graph`/`dynamic`/`agy_harness` workflows with a RequestInput HITL gate:
ENABLE_HITL_APPROVAL=false
# Optional ADK Python v2.4.0 Preview ManagedAgent ID (Agent Platform backend is `global`-only):
# MANAGED_AGENT_ID=antigravity-preview-05-2026
# Optional ADK Python 2.0+ programmatic Service Registration (`services.py` overrides `services.yaml`):
# ENABLE_CUSTOM_SERVICE_REGISTRY=false

# --- Lab 1 & Lab 2: Antigravity (`agy`) Headless CLI Harness -----------------
# Works locally (laptop/CI/Cloud Workstations), in Agent Runtime (Custom SA ADC via
# `AGY_ADC_AUTH=true`), and inside gVisor BYOC Managed Sandboxes (zero local Docker!).
# Execution modes: auto | local | sandbox
#   - `auto` (default): uses BYOC sandbox when `SANDBOX_MODE=byoc` and `/health` reports
#     `agy_cli_available=true`, else local `agy` if on PATH, else falls back gracefully to
#     native ADK 2.0 `LlmAgent` + `EnvironmentToolset`.
# Enterprise Auth Boundary: NEVER proxy or relay a developer's personal OAuth credentials
# inside a multi-tenant service. On Agent Runtime, use `AGY_ADC_AUTH=true` with the
# dedicated least-privilege Service Account (`coding-agent-runtime-sa`).
AGY_BIN=agy
AGY_MODEL=gemini-4-hydrogen
AGY_EFFORT=medium
AGY_PRINT_TIMEOUT=5m
AGY_EXECUTION_MODE=auto
AGY_ENABLE_SANDBOX=true
AGY_SKIP_PERMISSIONS=false
AGY_ADC_AUTH=true
AGY_CLI_DISABLE_AUTO_UPDATE=true

# --- Lab 1 & Lab 2: Workspace, Managed Sandboxes & Backing Instance ----------
# Supported modes: local | shell | byoc | code_execution
SANDBOX_MODE=local
LOCAL_WORKSPACE_DIR=/tmp/coding_agent_workspace
MAX_OUTPUT_CHARS=12000

# Populated in Lab 2 (push BYOC sandbox image to Bangkok coding-agent-repo via `make push-sandbox` / Cloud Build):
# Verified working for Singapore BYOC Sandbox pulls from Bangkok Artifact Registry:
#   asia-southeast3-docker.pkg.dev/<PROJECT_ID>/coding-agent-repo/coding-sandbox:v1
SANDBOX_IMAGE_URI=
# Format: projects/<PROJECT_ID>/locations/<LOCATION>/reasoningEngines/<ID>/sandboxEnvironmentTemplates/<TPL_ID>
SANDBOX_TEMPLATE_NAME=
# Optional pre-existing sandbox resource name to reuse directly
SANDBOX_RESOURCE_NAME=
# Explicit sandbox TTL (default 2h if omitted; max 7d BYOC / 14d code execution)
SANDBOX_TTL=3600s
# Optional BYOC / HTTP data-plane access-token configuration
SANDBOX_SERVICE_ACCOUNT_EMAIL=
SANDBOX_RUNNER_BASE_URL=

# Backing Agent Platform instance (`ReasoningEngine`):
# - Created in Lab 2 as a standalone instance via `client.runtimes.create()`
# - Reused in Lab 3 for Managed Sessions, Memory Bank, Telemetry & Feedback
# - In Lab 5, either replace these from `terraform output` / `agents-cli deploy`
#   to unify on the deployed Agent Runtime, or keep them paired separately
# Format: projects/<PROJECT_ID>/locations/<LOCATION>/reasoningEngines/<NUMERIC_ID>
REASONING_ENGINE_NAME=
# Short numeric ID of the backing / deployed ReasoningEngine
REASONING_ENGINE_ID=

# --- Lab 3: Managed Sessions, Memory Bank, Telemetry & Feedback --------------
# Reuses Lab 2's standalone backing instance (REASONING_ENGINE_NAME / REASONING_ENGINE_ID).
ENABLE_TELEMETRY_CALLBACKS=true
ENABLE_MEMORY_BANK=false

# Mandatory OTel GenAI Semantic Conventions (v1.37.0+) flags for Traces & Online Monitors.
# CRITICAL ADK Python Gotcha: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT
# accepts ENUM strings ONLY (NO_CONTENT | EVENT_ONLY | SPAN_ONLY | SPAN_AND_EVENT).
# Passing `true` or `false` is invalid in Python and silently falls back to NO_CONTENT!
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# Optional production multimodal / large-payload GCS offloading (Lab 6 Part 1.3):
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://your-eval-bucket/otel-completions

# --- Lab 4: Skill Registry & Agent Registry Discovery ------------------------
ENABLE_SKILL_REGISTRY=false
# Vertex AI Skill Registry (v1beta1 Preview) is strictly available in 3 regions:
#   us-central1 | europe-west4 | us-east5
SKILL_REGISTRY_LOCATION=us-central1
# Agent Registry A2A / MCP discovery (Bangkok first; verified working in `asia-southeast3`)
AGENT_REGISTRY_LOCATION=asia-southeast3
# Agent Registry standalone skills (`gcloud alpha agent-registry skills` + ADK `GCPSkillRegistry`):
# Standalone skills require `global` (not yet available in `asia-southeast3`).
AGENT_REGISTRY_SKILLS_LOCATION=global
# Optional endpoint override for ADK GCPSkillRegistry (default: https://agentregistry.googleapis.com/v1alpha)
AGENT_REGISTRY_ENDPOINT=
# Optional Agent Registry discovery identifiers (Lab 4)
AGENT_REGISTRY_AGENT_ID=
MCP_SERVER_RESOURCE_NAME=

# --- Lab 5: Agent Runtime (ReasoningEngine) & Terraform Deployment -----------
# Populated in Lab 5 (`make push-agent` — trusted Agent Runtime BYOC image via Cloud Build; zero local Docker):
# Verified working for Singapore Agent Runtime pulls from Bangkok Artifact Registry:
#   asia-southeast3-docker.pkg.dev/<PROJECT_ID>/coding-agent-repo/coding-agent:v1
AGENT_IMAGE_URI=
# After `terraform apply` (or `agents-cli deploy`), either update
# REASONING_ENGINE_NAME / REASONING_ENGINE_ID above to unify on the deployed
# runtime, or keep Lab 2's standalone instance paired for Sessions/Memory/Sandboxes.

# --- Lab 6: Optimize, Offline/Simulated/Online Evaluation & Quality Alerts ---
# Gen AI Evaluation Service supports 14 US/EU regions + `global` (`global` is APAC-ready
# AND supports `generate_loss_clusters` / `agents-cli eval analyze` in the same client).
EVAL_LOCATION=global
# GCS bucket name (without gs:// prefix) for evaluation outputs and OTel offload
EVAL_GCS_BUCKET=
# Online Evaluation Monitor defaults (configured in Console; validated by setup_online_monitor.py)
ONLINE_MONITOR_SAMPLING_RATE=0.2
ONLINE_MONITOR_MAX_SAMPLES_PER_RUN=25
# Optional comma-separated Cloud Monitoring notification channels:
#   projects/<PROJECT_ID>/notificationChannels/<CHANNEL_ID>
# Leave empty during workshops to record alert incidents quietly without paging.
ALERT_NOTIFICATION_CHANNELS=
# Optional revision resource names for Lab 6 Part 6.3 90/10 canary traffic split
STABLE_REVISION_NAME=
CANARY_REVISION_NAME=

# --- Optional Lab 7: Enterprise Security & Governance Hardening --------------
# Optional Semantic Governance authorization extension identifier (skippable):
SGP_AUTHZ_EXT_NAME=

# --- Lab 8: Self-Hosted GKE Agent Sandbox Reference Overlay ------------------
# Bangkok (`asia-southeast3`) GKE cluster — highlights strict Thailand PDPA / BoT compute residency.
GKE_LOCATION=asia-southeast3
# Used only when running `gke_reference/gke_agent_example.py` against a GKE cluster:
# GKE_SANDBOX_NAMESPACE=agent-sandbox-system
# GKE_SANDBOX_TEMPLATE=coding-sandbox-template
# GKE_SANDBOX_WARMPOOL=coding-sandbox-warmpool
# GKE_SANDBOX_GATEWAY_NAME=

# --- Optional CLI Telemetry Opt-Out ------------------------------------------
# Uncomment to disable anonymous google/agents-cli usage telemetry:
# AGENTS_CLI_TELEMETRY=0
