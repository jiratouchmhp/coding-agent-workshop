# =============================================================================
# Enterprise Coding Agent Workshop — Environment Configuration Template
# =============================================================================
# Copy to `.env` at the repository root and fill in your GCP project values:
#   cp .env.example .env
# Never commit `.env` to version control.
#
# IMPORTANT — Standard Billing GCP Project Required for Labs 2-7:
# Do NOT set GOOGLE_GENAI_API_KEY or GEMINI_API_KEY (Express Mode / AI Studio)
# when running Labs 2-7; Express Mode enforces strict free-tier caps (10 agents,
# 10 QPM, 30 session appends/min) and disables BYOC Sandboxes, Terraform IAM,
# Registries, Online Monitors, and Cloud Monitoring Alerts.
# =============================================================================

# --- Core GCP Project & Region (Labs 0-7) ------------------------------------
# Standardize on `us-central1` (Americas/Global) or `europe-west4` (EMEA).
# Both golden regions support 100% of Labs 1-7 (including Skill Registry,
# Semantic Governance, Memory Bank, and GenAI Evaluation).
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
GOOGLE_CLOUD_LOCATION=us-central1

# Explicit versioned Gemini model ID.
# Do NOT use `gemini-flash-latest` on regional Agent Platform endpoints.
MODEL_NAME=gemini-2.5-flash

# --- Lab 1: ADK 2.0 Agent Architecture & Workflow Orchestration --------------
# Valid values: simple | collaborative | graph | dynamic
# Keep `simple` as the default so Labs 2-7 run unchanged (and ADK 1.29.x stays compatible).
AGENT_ARCHITECTURE=simple
# Explicit safety bound on fix iterations in `graph` and `dynamic` workflows:
MAX_FIX_ROUNDS=3
# Set to `true` to pause `graph`/`dynamic` workflows with a RequestInput HITL approval gate:
ENABLE_HITL_APPROVAL=false
# Optional ADK Python v2.4.0 Preview ManagedAgent ID (Agent Platform backend is `global`-only):
# MANAGED_AGENT_ID=antigravity-preview-05-2026
# Optional ADK Python v1.34.0 programmatic Service Registration (`services.py` overrides `services.yaml`):
# ENABLE_CUSTOM_SERVICE_REGISTRY=false

# --- Lab 1 & Lab 2: Workspace & Managed Sandbox Execution --------------------
# Supported modes: local | shell | byoc | code_execution
SANDBOX_MODE=local
LOCAL_WORKSPACE_DIR=/tmp/coding_agent_workspace
MAX_OUTPUT_CHARS=12000

# Populated in Lab 2 (push BYOC sandbox image to coding-agent-repo):
# Format: <LOCATION>-docker.pkg.dev/<PROJECT_ID>/coding-agent-repo/coding-sandbox:v1
SANDBOX_IMAGE_URI=
# Format: projects/<PROJECT_ID>/locations/<LOCATION>/reasoningEngines/<ID>/sandboxEnvironmentTemplates/<TPL_ID>
SANDBOX_TEMPLATE_NAME=
# Optional pre-existing sandbox resource name to reuse directly
SANDBOX_RESOURCE_NAME=
# Explicit sandbox TTL (default 2h if omitted; max 7d BYOC / 14d code execution)
SANDBOX_TTL=3600s
# Optional BYOC / HTTP data-plane access-token configuration
SANDBOX_SERVICE_ACCOUNT_EMAIL=
SANDBOX_RUNNER_BASE_URL=

# --- Lab 3: Agent Runtime (ReasoningEngine) & Terraform Deployment -----------
# Populated in Lab 3 Step B0 (trusted Agent Runtime BYOC image):
# Format: <LOCATION>-docker.pkg.dev/<PROJECT_ID>/coding-agent-repo/coding-agent:v1
AGENT_IMAGE_URI=
# Populated in Lab 3 Step B4 from `terraform output`:
# Format: projects/<PROJECT_ID>/locations/<LOCATION>/reasoningEngines/<NUMERIC_ID>
REASONING_ENGINE_NAME=
# Short numeric ID of the deployed ReasoningEngine
REASONING_ENGINE_ID=

# --- Lab 4: Managed Sessions, Memory Bank & OpenTelemetry Telemetry ----------
ENABLE_TELEMETRY_CALLBACKS=true
ENABLE_MEMORY_BANK=false

# Mandatory OTel GenAI Semantic Conventions (v1.37.0+) flags for Traces & Online Monitors.
# CRITICAL ADK Python Gotcha: OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT
# accepts ENUM strings ONLY (NO_CONTENT | EVENT_ONLY | SPAN_ONLY | SPAN_AND_EVENT).
# Passing `true` or `false` is invalid in Python and silently falls back to NO_CONTENT!
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# Optional production multimodal / large-payload GCS offloading (Lab 6 Part 1.3):
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH=gs://your-eval-bucket/otel-completions

# --- Lab 5: Skill Registry, Agent Registry & Semantic Governance -------------
ENABLE_SKILL_REGISTRY=false
# Vertex AI Skill Registry (v1beta1) is ONLY available in:
#   us-central1 | europe-west4 | us-east5
SKILL_REGISTRY_LOCATION=us-central1
# Agent Registry standalone skills (global | us | eu | regional)
AGENT_REGISTRY_LOCATION=us-central1
# Optional endpoint override for ADK GCPSkillRegistry (default: https://agentregistry.googleapis.com/v1alpha)
AGENT_REGISTRY_ENDPOINT=
# Optional Agent Registry / Semantic Governance identifiers (Lab 5 Part D)
AGENT_REGISTRY_AGENT_ID=
MCP_SERVER_RESOURCE_NAME=
SGP_AUTHZ_EXT_NAME=

# --- Lab 6: Optimize, Offline/Simulated/Online Evaluation & Quality Alerts ---
# Eval Service supports 15 US/EU regions + `global` (`generate_loss_clusters` and
# `agents-cli eval analyze` are `global`-only).
EVAL_LOCATION=us-central1
# GCS bucket name (without gs:// prefix) for evaluation outputs and OTel offload
EVAL_GCS_BUCKET=
# Online Evaluation Monitor defaults (configured in Console; validated by setup_online_monitor.py)
ONLINE_MONITOR_SAMPLING_RATE=0.2
ONLINE_MONITOR_MAX_SAMPLES_PER_RUN=25
# Optional comma-separated Cloud Monitoring notification channels:
#   projects/<PROJECT_ID>/notificationChannels/<CHANNEL_ID>
# Leave empty during workshops to record alert incidents quietly without paging.
ALERT_NOTIFICATION_CHANNELS=
# Optional revision resource names for Lab 6 Part 6.3 90/10 canary traffic split
STABLE_REVISION_NAME=
CANARY_REVISION_NAME=

# --- Optional Lab 7: Self-Hosted GKE Agent Sandbox Reference Overlay ---------
# Used only when running `gke_reference/gke_agent_example.py` against a GKE cluster:
# GKE_SANDBOX_NAMESPACE=agent-sandbox-system
# GKE_SANDBOX_TEMPLATE=coding-sandbox-template
# GKE_SANDBOX_WARMPOOL=coding-sandbox-warmpool
# GKE_SANDBOX_GATEWAY_NAME=

# --- Optional CLI Telemetry Opt-Out ------------------------------------------
# Uncomment to disable anonymous google/agents-cli usage telemetry:
# AGENTS_CLI_TELEMETRY=0
