# Copy this file to `terraform.tfvars` (gitignored) and replace placeholder values
# with your GCP project settings from `.env`:
#
#   cp solution/terraform/terraform.tfvars.example solution/terraform/terraform.tfvars
#
# Never commit `terraform.tfvars` or real secrets to version control.

project_id     = "your-gcp-project-id"
project_number = "123456789012"
# Aim for Bangkok (asia-southeast3) first; fall back to Singapore (asia-southeast1) for Agent Runtime (not yet in Bangkok):
location        = "asia-southeast1"
repository_name = "coding-agent-repo"
display_name    = "coding_agent_byoc_tf"
# Bangkok AR (asia-southeast3-docker.pkg.dev) is verified working for both Singapore Agent Runtime and Singapore BYOC Sandboxes (no second Singapore AR repo needed):
agent_image_uri                = "asia-southeast3-docker.pkg.dev/your-gcp-project-id/coding-agent-repo/coding-agent:v1"
sandbox_image_uri              = "asia-southeast3-docker.pkg.dev/your-gcp-project-id/coding-agent-repo/coding-sandbox:v1"
sandbox_template_name          = ""
sandbox_mode                   = "" # Empty auto-selects "byoc" when sandbox_template_name is set, else "shell"
model_name                     = "gemini-4-hydrogen"
reasoning_model_name           = "gemini-4-neon"
model_location                 = "global" # Required for gemini-4-hydrogen/neon; use "asia-southeast1" with "gemini-4-argon" for regional residency
thinking_level                 = "MEDIUM" # LOW | MEDIUM | HIGH | XHIGH (MINIMAL returns HTTP 400 on Gemini 4)
agy_execution_mode             = "auto"   # auto | local | sandbox
api_key_value                  = "replace-with-workshop-placeholder-value"
enable_memory_bank             = false
enable_skill_registry          = false
skill_registry_location        = "us-central1"     # Vertex AI Skill Registry Preview (GCP-mandated: us-central1 | europe-west4 | us-east5)
agent_registry_location        = "asia-southeast3" # Agent Registry A2A/MCP discovery (Bangkok first)
agent_registry_skills_location = "global"          # Agent Registry standalone skills (falls back to global; times out in asia-southeast3)
